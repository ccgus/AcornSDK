				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}		repeat with theItem in input		tell application "Acorn-5.6.4"			activate			set doc to open (theItem as alias)			tell doc				do filter name "Add Border to Layer"				save				close			end tell		end tell	end repeat	return inputend run</string>
				</dict>
