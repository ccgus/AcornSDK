				<key>ActionBundlePath</key>
				<string>/Users/gus/Library/Automator/Do JavaScript.action</string>
				<key>ActionName</key>
				<string>Do JavaScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>function main(input) {
	var idx = 0;
	
	var baseDoc = [[NSDocumentController sharedDocumentController] makeUntitledDocumentWithSize:NSMakeSize(10, 10)];
	
	var currentY = 0;
	var maxWidth = 0;
	
	while (idx &lt; input.length()) {
    
	    var layer = [baseDoc addLayerWithImagePath:input[idx]];
	    
	    var bounds = [layer opaqueBounds];
	    
	    [layer setFrameOrigin:NSMakePoint(0, currentY)];
	    
	    currentY += bounds.size.height;
	    
	    maxWidth = Math.max(maxWidth, bounds.size.width);
	    
	    idx++;
    }
    
    Acorn.activate();
    [baseDoc setCanvasSize:NSMakeSize(maxWidth, currentY)];
    
}</string>
				</dict>
