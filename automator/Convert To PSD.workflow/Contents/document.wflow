				<key>ActionName</key>
				<string>Do JavaScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>function main(input) {
    
    var idx = 0;
    
    while (idx &lt; input.length()) {
        var filePath = input[idx];
        idx++;
        
        print(filePath);
        
        var doc = Acorn.open(filePath);
        
        var url = [[[doc fileURL] URLByDeletingPathExtension] URLByAppendingPathExtension:"psd"];
        
        // Private api, but it'll work perfectly fine with Acorn 4.x
        [doc writePSDToURL:url]
        
    }
}
</string>
				</dict>
